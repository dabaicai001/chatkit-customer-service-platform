# ============================================================
# 通用客服平台 · 环境变量模板(准生产/生产)
# 用法:cp .env.example .env,填入真实值;.env 已在 .gitignore,不会进仓库
# 启动脚本(scripts/run-backend.sh / run-backend.ps1)会自动加载 backend/.env
# ============================================================

# ---------- Jev 决策模型(大脑/判断器,小模型即可) ----------
# base_url 已在 business.yaml 配默认值(https://api.typesafe.ai);
# Jev 的真实端点是 TypeSafe SystemOne(POST /v1/systemone),不是 OpenAI
# Chat Completions——没有 /chat/completions 路径,不要拼、也不要让
# 客户端自动拼该路径;要覆盖地址才取消下面注释
JEV_PROVIDER=openjev
# JEV_BASE_URL=https://api.typesafe.ai
JEV_API_KEY=sk-replace-with-real-je-v-key
JEV_MODEL=jev-latest

# ---------- chat 话术生成模型(把话说好,大模型;厂商不限) ----------
# base_url 默认 MiniMax 的 OpenAI 兼容端点(https://api.minimax.cn/v1);
# 换厂商只改 CHAT_BASE_URL + CHAT_MODEL
CHAT_PROVIDER=openai-compatible
# CHAT_BASE_URL=https://api.minimax.cn/v1
CHAT_API_KEY=sk-replace-with-real-chat-key
CHAT_MODEL=MiniMax-M3

# ---------- 会话标题生成 ----------
# 默认复用上面的 CHAT_PROVIDER/CHAT_BASE_URL/CHAT_API_KEY/CHAT_MODEL;
# 如需独立标题模型,改 business.yaml 的 models.title 段指向其他环境变量。

# ---------- MCP 数据面(上游业务系统的 MCP Server) ----------
# url 默认 http://127.0.0.1:9003/mcp;按上游实际路径修改
UPSTREAM_MCP_URL=http://127.0.0.1:9003/mcp
UPSTREAM_MCP_TOKEN=replace-with-real-upstream-mcp-token

# ---------- 语音听写(可选;不配则听写不可用,文字对话不受影响) ----------
# OPENAI_API_KEY=

# ---------- 服务端口(可选,默认 8001) ----------
# PORT=8001
