# ============================================================
# 通用客服平台 · 环境变量模板(准生产/生产)
# 用法:cp .env.example .env,填入真实值;.env 已在 .gitignore,不会进仓库
# 启动脚本(scripts/run-backend.sh)会自动加载 backend/.env
# ============================================================

# ---------- Jev 决策模型(大脑/判断器,小模型即可) ----------
# provider: openjev | qwen | openai(任何 OpenAI 兼容网关,按实际填)
JEV_PROVIDER=openjev
JEV_BASE_URL=https://your-jev-gateway.internal/v1
JEV_API_KEY=sk-replace-with-real-je-v-key
JEV_MODEL=openjev-qwen4b

# ---------- Qwen 生成模型(把话说好,大模型) ----------
# 例(DashScope 兼容模式):https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_PROVIDER=qwen
QWEN_BASE_URL=https://your-qwen-endpoint.internal/v1
QWEN_API_KEY=sk-replace-with-real-qwen-key
QWEN_MODEL=qwen3.8-14b

# ---------- 会话标题生成 ----------
# 默认复用上面的 QWEN_PROVIDER/QWEN_BASE_URL/QWEN_API_KEY/QWEN_MODEL;
# 如需独立标题模型,改 business.yaml 的 models.title 段指向其他环境变量。

# ---------- MCP 数据面(上游 CRM/OMS/工单系统) ----------
CRM_MCP_URL=https://your-upstream-mcp.internal/mcp
CRM_MCP_TOKEN=replace-with-real-mcp-token

# ---------- 语音听写(可选;不配则听写不可用,文字对话不受影响) ----------
# OPENAI_API_KEY=

# ---------- 服务端口(可选,默认 8001) ----------
# PORT=8001
