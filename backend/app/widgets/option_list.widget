{
  "version": "1.0",
  "name": "option_list",
  "template": "{%- set option_list = options | default([]) -%}\n{%- set selected_id = selectedId | default(None) -%}\n{%- set title_text = title | default(\"请选择\") -%}\n{\n  \"type\": \"ListView\",\n  \"children\": [\n    {\n      \"type\": \"Title\",\n      \"value\": {{ (title_text) | tojson }},\n      \"size\": \"sm\"\n    }{%- for option in option_list %},\n    {%- set is_selected = selected_id == option.id %}\n    {\n      \"type\": \"ListViewItem\",\n      \"key\": {{ (option.id) | tojson }},\n      \"onClickAction\": {% if is_selected %}{{ (none) | tojson }}{% else %}{\n        \"type\": {{ (actionType) | tojson }},\n        \"handler\": \"server\",\n        \"loadingBehavior\": \"auto\",\n        \"payload\": {\n          \"id\": {{ (option.id) | tojson }},\n          \"option\": {{ (option) | tojson }}\n        }\n      }{% endif %},\n      \"children\": [\n        {\n          \"type\": \"Row\",\n          \"gap\": 2,\n          \"align\": \"center\",\n          \"children\": [\n            {\n              \"type\": \"Icon\",\n              \"name\": {% if is_selected %}\"check\"{% else %}\"empty-circle\"{% endif %},\n              \"color\": \"secondary\"\n            },\n            {\n              \"type\": \"Col\",\n              \"gap\": 1,\n              \"children\": [\n                {\n                  \"type\": \"Text\",\n                  \"value\": {{ (option.title) | tojson }},\n                  \"weight\": {% if is_selected %}\"semibold\"{% else %}\"medium\"{% endif %}\n                },\n                {\n                  \"type\": \"Caption\",\n                  \"value\": {{ (option.subtitle) | tojson }},\n                  \"color\": \"secondary\"\n                }\n              ]\n            },\n            {\n              \"type\": \"Spacer\"\n            },\n            {\n              \"type\": \"Badge\",\n              \"label\": {{ (option.badge) | tojson }},\n              \"color\": {{ (option.badge_color) | tojson }},\n              \"variant\": \"soft\"\n            }\n          ]\n        }\n      ]\n    }{%- endfor %}\n  ]\n}"
}
