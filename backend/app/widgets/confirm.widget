{
  "version": "1.0",
  "name": "confirm",
  "template": "{%- set prompt_text = prompt | default(\"确认执行该操作吗?\") -%}\n{%- set title_text = title | default(\"操作确认\") -%}\n{\n  \"type\": \"Card\",\n  \"children\": [\n    {\n      \"type\": \"Title\",\n      \"value\": {{ (title_text) | tojson }},\n      \"size\": \"sm\"\n    },\n    {\n      \"type\": \"Text\",\n      \"value\": {{ (prompt_text) | tojson }}\n    },\n    {\n      \"type\": \"Row\",\n      \"gap\": 2,\n      \"children\": [\n        {\n          \"type\": \"Button\",\n          \"label\": \"确认\",\n          \"style\": \"primary\",\n          \"onClickAction\": {\n            \"type\": {{ (confirmActionType) | tojson }},\n            \"handler\": \"server\",\n            \"loadingBehavior\": \"auto\",\n            \"payload\": {\n              \"action_id\": {{ (actionId) | tojson }}\n            }\n          }\n        },\n        {\n          \"type\": \"Button\",\n          \"label\": \"取消\",\n          \"style\": \"secondary\",\n          \"variant\": \"outline\",\n          \"onClickAction\": {\n            \"type\": {{ (cancelActionType) | tojson }},\n            \"handler\": \"server\",\n            \"loadingBehavior\": \"auto\",\n            \"payload\": {\n              \"action_id\": {{ (actionId) | tojson }}\n            }\n          }\n        }\n      ]\n    }\n  ]\n}"
}
