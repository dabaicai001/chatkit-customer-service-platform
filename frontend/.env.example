# ============================================================
# 前端环境变量模板
# 用法:cp .env.example .env,填入真实值;.env 已在 .gitignore
# ============================================================

# ---------- 后端 API 基址(默认 /support,由 vite 代理到 8001) ----------
# 前后端不同域时必须填完整地址,例如 https://cs-api.your-domain.com
# VITE_SUPPORT_API_BASE=/support

# ---------- ChatKit 域名密钥(准生产/生产必须填真实值!) ----------
# 到 https://platform.openai.com/settings/organization/security/domain-allowlist
# 注册你的域名,拿到 domain_pk_... 后填入。本地开发可用任意非空占位符。
VITE_CHATKIT_API_DOMAIN_KEY=domain_pk_replace_with_real_key
